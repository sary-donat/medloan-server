<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variables>
    <!-- הרמה המינימלית לקוד שלנו נקראת מ-appsettings: Debug בפיתוח, Info בייצור -->
    <variable name="appMinLevel" value="${configsetting:item=AppLogging.MinLevel:default=Info}" />
    <variable name="layout"
      value="${longdate}|${level:uppercase=true:padding=-5}|${scopeproperty:CorrelationId:whenEmpty=-}|${logger:shortName=true}|${message} ${exception:format=tostring}" />
  </variables>

  <targets>
    <!-- console: חובה ב-Render, שם הקבצים נמחקים בכל deploy -->
    <target xsi:type="Console" name="console" layout="${layout}" />

    <target xsi:type="File" name="file"
            fileName="logs/medloan-${shortdate}.log"
            layout="${layout}"
            maxArchiveFiles="14" />

    <!-- קובץ נפרד לאירועים חשובים בלבד: התנגשויות ושגיאות -->
    <target xsi:type="File" name="important"
            fileName="logs/medloan-important-${shortdate}.log"
            layout="${layout}" />
  </targets>

  <rules>
    <!-- רעש של Microsoft מתחת ל-Warning: נבלע -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- הקוד שלנו -->
    <logger name="MedLoan.*" minlevel="${appMinLevel}" writeTo="console,file" />
    <logger name="Program" minlevel="Warn" writeTo="important" />   <!-- ILogger<Program>, למשל כשלי JWT (11.4) -->
    <logger name="MedLoan.*" minlevel="Warn" writeTo="important" final="true" />

    <!-- כל השאר (Warning ומעלה של Microsoft וכו') -->
    <logger name="*" minlevel="Warn" writeTo="console,file" />
  </rules>
</nlog>
